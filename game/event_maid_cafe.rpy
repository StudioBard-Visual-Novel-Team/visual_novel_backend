# 이벤트 씬 6 – 농업축제 메이드 카페
# 농업축제장 → 교실형 메이드 카페

label event_maid_cafe:
    stop music fadeout 1.5
    scene bg festival
    with fade
    play music "audio/festival_music_3.mp3" fadein 2.0

    narrator "농업축제 당일, 학교 안에는 평소보다 많은 사람이 오가고 있었다."
    narrator "운동장에서는 원예 모종 판매가 진행됐고, 실습동 앞에서는 식품가공 시식과 스마트팜 체험이 열리고 있었다."
    narrator "나는 체험 부스를 둘러본 뒤 교실 건물 쪽으로 향했다."

    scene bg school_festival_hallway
    with fade

    narrator "홍보 학생이 안내판을 들고 내 앞을 막아섰다."

    stu "오빠~ 여기 메이드 카페 있어요! 맛있는 음료도 있고 귀여운 메이드도 있어요!"
    p "갑자기요?"
    stu "한 번만 들어가 보세요. 자리도 있어요. 대신 들어가면 주문 하나는 해야 해요."
    p "그건 처음 듣는데."

    narrator "나는 홍보 학생에게 등을 떠밀려 교실 안으로 들어갔다."

    stop music fadeout 1.5
    scene bg maid_cafe
    with fade
    play music "audio/maid_cafe__music_1.mp3" fadein 2.0

    narrator "교실은 천과 종이 장식으로 꾸며져 있었지만 책상과 칠판은 그대로 남아 있어 학교 축제 부스라는 느낌이 강했다."
    narrator "입구 옆 메뉴판에는 오늘 주문을 받을 학생들의 이름이 적혀 있었다."

    menu:
        "주문을 받을 메이드를 고른다."
        "서하린에게 주문한다.":
            $ maid_partner = "harin"
            jump maid_harin
        "강연희에게 주문한다.":
            $ maid_partner = "yeonhee"
            jump maid_yeonhee
        "차유나 선배에게 주문한다.":
            $ maid_partner = "yuna"
            jump maid_yuna


# ---------- 서하린 루트 ----------
label maid_harin:
    show harin neutral at center
    with dissolve

    narrator "하린은 앞치마 끝을 손으로 잡은 채 내 테이블로 다가왔다."

    h "……주문 받을게요."

    narrator "작은 목소리였지만 메뉴를 읽는 소리는 또렷했다."

    p "하린이도 여기 있었네. 메이드복 잘 어울려."

    narrator "하린의 손이 메뉴판 위에서 멈췄다."

    h "원예 부스가 끝난 뒤에 잠깐 도와달라고 해서요. 주문부터 해주세요."
    p "아이스티로 할게."
    h "네. 아이스티 한 잔이요."

    narrator "잠시 후 하린이 아이스티를 들고 돌아왔다."
    narrator "컵을 내려놓은 하린은 옆에 놓인 작은 안내 카드를 확인했다."

    h "이제 이걸 해야 한대요."

    narrator "하린은 컵을 두 손으로 감싸듯 손을 모았다."

    h "맛있어져라…… 모에모에 큥."

    narrator "하린의 목소리는 작았지만 끝까지 멈추지 않았다."

    p "생각보다 제대로 하는데?"
    h "중간에 멈추면 더 부끄럽잖아요."

    menu:
        "부끄러워도 끝까지 해줘서 고마워.":
            p "부끄러워도 끝까지 해줘서 고마워. 열심히 하는 사람을 웃을 생각은 없어."
            h "다른 테이블에서는 웃는 사람도 있었거든요. 저는 그게 놀리는 건지 구분하기 어려워요."
            p "나는 놀리는 거 아니야. 잘했어."

            narrator "하린은 앞치마 끝을 잡았던 손을 천천히 놓았다."

            h "그러면 다음 주문도 받을 수 있을 것 같아요."

            $ harin_affection += 2

        "이제 마셔도 되는 거지?":
            p "이제 마셔도 되는 거지?"
            h "네. 이제 괜찮아요."

            narrator "나는 아이스티를 한 모금 마셨다."

            h "맛은 어때요?"
            p "아이스티 맛인데, 방금 주문 때문에 조금 특별해진 것 같아."

            narrator "하린은 긴장이 풀린 듯 작게 웃었다."

        "조금 더 크게 했으면 잘 들렸을 텐데.":
            p "조금 더 크게 했으면 잘 들렸을 텐데."

            narrator "하린의 표정이 굳었다."

            h "저는 이게 최대였어요. 들렸으면 된 거죠."
            p "안 들린 건 아니야."

            narrator "하린은 빈 쟁반을 품에 안고 시선을 내렸다."

            $ harin_affection -= 1

    # 공통 후속 내용
    p "계속 주문 받는 거야?"
    h "교대 시간까지는요. 처음에는 거절하려고 했는데 다른 학생들도 바빠 보여서 제가 해도 괜찮겠다고 생각했어요."
    p "갑자기 맡았는데도 잘했어."
    h "선배가 첫 손님이라서 조금 덜 떨렸어요. 다음에는 지금보다 자연스럽게 할 수 있을 것 같아요."

    narrator "하린은 다음 테이블을 바라보다가 작게 숨을 내쉬었다."

    h "그래도 모에모에 큥은 아직 익숙해지기 어려울 것 같아요."
    p "끝까지 했으니까 됐어."

    narrator "하린은 쟁반을 고쳐 들고 다음 주문을 받으러 향했다."

    hide harin
    with dissolve
    jump maid_end


# ---------- 강연희 루트 ----------
label maid_yeonhee:
    show yeonhee neutral at center
    with dissolve

    narrator "연희가 쟁반을 들고 밝게 다가왔다."

    y "어서 오세요, 주인님."
    p "처음부터 너무 자연스러운데?"
    y "이 정도는 해야 인기 메이드가 되지. 주문은 뭘로 하시겠어요, 주인님?"
    p "호칭을 계속 붙여야 해? 그럼 레몬에이드."
    y "서비스에 포함되어 있습니다. 잠시만 기다려주세요."

    narrator "잠시 후 연희가 레몬에이드를 들고 돌아왔다."
    narrator "컵을 내려놓고 양손으로 하트 모양을 만들었다."

    y "맛있어져라, 모에모에 큥!"
    p "너는 하나도 안 부끄럽지?"
    y "왜? 너는 부끄러워?"
    p "조금."
    y "그럼 성공이네."

    menu:
        "네가 즐거워 보이니까 나도 괜찮네.":
            p "네가 즐거워 보이니까 나도 괜찮네."

            narrator "연희는 손으로 만들었던 하트 모양을 풀었다."

            y "처음에는 그냥 너 놀리려고 했는데, 네가 웃으니까 나도 진짜 재밌어졌어."
            p "나는 재미있었어."
            y "그럼 오늘 최고 손님으로 인정. 내 순위는 내가 정하니까 괜찮아."

            $ yeonhee_affection += 2

        "축제니까 이 정도는 할 수 있지.":
            p "축제니까 이 정도는 할 수 있지."
            y "좋아. 적응이 빠른 손님이네. 아직 디저트 주문이 남았는데?"
            p "음료만 마실 거야."
            y "그러면 서비스는 여기까지. 조금 아쉬운 표정이지만 그렇게 믿어줄게."

        "너무 신나 보여서 따라가기 힘들어.":
            p "너무 신나 보여서 따라가기 힘들어."

            narrator "연희는 쟁반을 한 손으로 고쳐 들었다."

            y "그럼 조금 줄여줄게. 손님한테 맞추는 것도 일이니까."
            p "즐기지 말라는 뜻은 아니야."
            y "알아. 음료는 편하게 마셔."

            narrator "연희는 전보다 차분한 목소리로 말한 뒤 잠시 거리를 두었다."

            $ yeonhee_affection -= 1

    # 공통 후속 내용
    y "음료 맛은 어때?"
    p "평범한 레몬에이드인데 축제 분위기는 제대로 나."
    y "그 정도면 성공이네. 손님이 끝까지 앉아서 마시고 있으니까 점수도 높게 줄게."

    narrator "연희는 메뉴판을 뒤집어 실제 평가표가 있는 것처럼 훑어봤다."

    y "주문 태도는 보통, 메이드에게 협조한 정도는 높음. 성실하게 끝까지 마시는 점도 가산점."
    p "평가 기준을 네가 마음대로 만들고 있잖아."
    y "오늘은 내가 담당이니까. 최종 결과는 축제가 끝난 뒤 알려줄게."

    narrator "연희는 다음 주문을 받으러 가면서 내 쪽을 향해 가볍게 손을 흔들었다."

    hide yeonhee
    with dissolve
    jump maid_end


# ---------- 차유나 루트 ----------
label maid_yuna:
    show yuna neutral at center
    with dissolve

    narrator "선배는 검은 쟁반을 들고 내 테이블 앞에 섰다."

    sen "주문 받아도 될까."
    p "선배도 메이드 카페에 계셨네요."
    sen "학생회 인원이 부족해서 지원 나온 거야."
    p "메이드복까지 입으실 줄은 몰랐어요."
    sen "나도 몰랐어. 주문은?"
    p "아이스커피로 할게요. 다른 테이블에서는 주인님이라고 부르던데요."

    narrator "선배의 시선이 잠시 멈췄다."

    sen "그게 듣고 싶어?"
    p "규칙이면요."
    sen "……잠시만 기다려, 주인님."

    narrator "선배는 그대로 돌아섰지만 귀가 조금 붉어져 있었다."
    narrator "잠시 후 아이스커피를 가져온 선배는 안내 카드를 확인하고 컵 위로 손을 모았다."

    sen "맛있어져라…… 모에모에 큥."
    p "선배도 하시네요."
    sen "규칙이라며."

    menu:
        "부끄러우셨을 텐데 해주셔서 감사해요.":
            p "부끄러우셨을 텐데 해주셔서 감사해요. 끝까지 하셨잖아요."
            sen "부끄러운 건 맞아. 맡은 역할이니까 한 거야."
            p "제가 손님이라서 해주신 것도 조금 있지 않나 해서요."

            narrator "선배의 시선이 잠시 흔들렸다."

            sen "다른 손님이어도 했을 거야. 커피나 마셔."

            narrator "말투는 차분했지만 선배의 귀는 여전히 붉었다."

            $ yuna_affection += 2

        "생각보다 잘 어울리세요.":
            p "생각보다 잘 어울리세요. 평소에는 이런 옷을 안 입으시니까 더 기억에 남을 것 같아요."
            sen "생각보다라는 말이 걸리네. 오늘만 봐."
            p "이미 봤는데 어떻게 잊어요."

            narrator "선배는 대답 대신 메뉴판을 정리했다."

        "목소리가 너무 작아서 거의 안 들렸어요.":
            p "목소리가 너무 작아서 거의 안 들렸어요."

            narrator "선배의 표정이 차분하게 굳었다."

            sen "들렸으면 됐어. 다음부터는 안내 카드만 보여줄게."
            p "그건 서비스가 아니지 않아요?"
            sen "불만 있으면 담당을 바꿔. 아니면 커피를 마셔."

            $ yuna_affection -= 1

    # 공통 후속 내용
    narrator "나는 아이스커피를 한 모금 마셨다."

    sen "맛은 어때?"
    p "평소보다 조금 맛있는 것 같아요. 선배가 주문을 받아서 그런가 봐요."

    narrator "선배는 쟁반을 들어 올리다 잠시 멈췄다."

    sen "그런 말은 다른 사람에게 쉽게 하지 마. 듣는 사람이 다르게 받아들일 수도 있으니까."
    p "선배도 그렇게 들으셨어요?"

    narrator "선배는 바로 대답하지 않고 주변 테이블을 확인했다."

    sen "지금은 일하는 중이야. 커피나 다 마셔."

    narrator "선배는 다음 테이블로 향하다가 잠시 돌아봤다."

    sen "축제 끝날 때까지는 자리 비우지 말고."

    narrator "그 말이 손님에게 하는 안내인지, 조금 더 머물라는 뜻인지는 분명하지 않았다."

    hide yuna
    with dissolve
    jump maid_end


# ---------- 메이드 카페 이벤트 종료 ----------
label maid_end:
    stop music fadeout 2.0

    scene black
    with fade
    pause 1.0

    jump event_fireworks
