# 이벤트 씬 2 – 학년 통합 축산 실습
# 축산 실습장(닭장) → 보건실

label event_barn:
    scene bg practice_room
    with fade

    narrator "오늘 축산 실습은 1, 2, 3학년이 함께 진행하는 학년 통합 수업이었다."
    narrator "학생들은 학년별로 맡은 활동을 나누었다."

    teach "1학년은 사료통과 물통을 채우고, 2학년은 닭장 상태와 유정란 수거함을 확인한다."

    narrator "교사는 실습장 뒤쪽에 모여 있던 3학년 학생들을 바라봤다."

    teach "3학년은 각 조의 실습을 돕고, 위험한 행동이 없는지 확인해."
    stu "네."

    narrator "1학년 학생들은 사료가 담긴 통을 나누어 들었다."
    narrator "2학년 학생들은 점검표와 수거용 바구니를 챙겼고, 3학년 학생들은 각 조 사이에 배치되었다."

    show yeonhee neutral at center
    with dissolve

    p "학년이 다 모이니까 실습장이 평소보다 훨씬 붐비네."
    y "그러게. 닭보다 학생이 더 많은 것 같아."
    p "닭들은 우리보다 사료에 더 관심 있어 보이는데."
    y "그럼 우리가 긴장해야 하는 쪽이네."

    narrator "닭장 안에서는 닭들이 바닥을 쪼거나 날개를 퍼덕이며 돌아다니고 있었다."
    narrator "하린은 1학년 학생들과 함께 사료통의 양을 확인했다."
    narrator "선배는 점검표를 들고 닭장 입구와 바닥 상태를 살폈다."

    teach "안으로 들어가면 갑자기 뛰지 마라. 닭이 놀라면 발밑으로 몰릴 수 있어."
    p "선생님, 닭이 먼저 달려오면 어떻게 해야 하나요?"
    teach "피하려고 급하게 움직이지 말고, 사료를 조금 떨어진 곳에 뿌려."

    narrator "교사는 닭장 바닥을 가리켰다."

    teach "사료나 물기가 떨어져 있을 수 있으니 발밑도 계속 확인하고."
    p "뛰지 말고, 닭이 오면 사료를 뿌리고, 발밑도 확인하면 되는 거죠."
    y "벌써 시험공부하듯이 외우네."
    p "처음 하는 실습이니까 제대로 기억해둬야지."

    hide yeonhee
    with dissolve
    show yuna neutral at center
    with dissolve

    narrator "선배가 우리 쪽으로 다가왔다."

    sen "설명은 잘 들었네. 안에서도 그대로 하면 돼."
    p "선배가 저희 조를 맡으시는 거예요?"
    sen "이쪽 구역을 맡았어."
    teach "한 조씩 들어가. 사람이 많으니까 맡은 구역에서만 움직이고."

    hide yuna
    with dissolve

    narrator "닭장 문이 열리자 학생들이 여러 명씩 안으로 들어갔다."
    narrator "1학년 학생들은 사료통과 물통 쪽으로 이동했다."
    narrator "2학년 학생들은 수거함과 닭장 벽면을 확인했고, 3학년 학생들은 조 사이를 오가며 실습을 도왔다."
    narrator "나도 점검표를 들고 닭장 안으로 들어갔다."
    narrator "마른 짚이 신발 밑에서 바스락거렸다."

    show yeonhee neutral at center
    with dissolve

    p "생각보다 닭들이 가까이서 움직이네."
    y "사료만 건드리지 않으면 괜찮을 거야."
    p "그 말을 하자마자 몰려오면 어떡해."

    narrator "근처에서 사료를 나누던 학생이 통을 움직이자 닭 몇 마리가 한꺼번에 모여들었다."

    p "잠깐, 진짜로 너무 많이 몰리는데?"

    hide yeonhee
    with dissolve
    show harin neutral at center
    with dissolve

    h "사료를 한쪽에 조금씩 뿌리면 돼요."

    narrator "하린이 닭장에서 조금 떨어진 곳에 사료를 뿌렸다."
    narrator "닭 몇 마리가 방향을 바꾸어 그쪽으로 이동했다."

    p "진짜 그쪽으로 가네. 다음에는 나도 그렇게 해야겠다."

    hide harin
    with dissolve
    show yeonhee neutral at center
    with dissolve

    y "닭 다루는 법 하나 배웠다."

    hide yeonhee
    with dissolve
    show yuna neutral at center
    with dissolve

    sen "구경만 하지 말고 맡은 구역 확인해."
    p "네. 수거함부터 확인할게요."

    hide yuna
    with dissolve

    narrator "각자 맡은 활동을 이어가던 중, 닭 한 마리가 갑자기 날개를 퍼덕이며 내 앞을 가로질렀다."

    p "어, 잠깐."

    narrator "나는 닭을 피하려고 한 발 뒤로 물러났다."

    stu "남주야, 뒤 조심해!"

    narrator "뒤꿈치 아래에서 사료 알갱이가 밀렸다."
    narrator "몸이 한쪽으로 크게 기울었다."

    p "어……!"

    narrator "넘어지지 않으려고 손을 뻗는 순간, 가장 가까이에 있던 누군가가 내 팔을 붙잡았다."

    menu:
        "누가 나를 붙잡았는지 확인한다."
        "서하린이 팔을 붙잡았다.":
            $ barn_partner = "harin"
            jump barn_harin
        "강연희가 팔을 붙잡았다.":
            $ barn_partner = "yeonhee"
            jump barn_yeonhee
        "차유나 선배가 팔을 붙잡았다.":
            $ barn_partner = "yuna"
            jump barn_yuna


# ---------- 서하린 루트 ----------
label barn_harin:
    show harin neutral at center
    with dissolve

    narrator "하린이 사료통을 내려놓고 내 팔을 붙잡았다."

    h "선배, 움직이지 마세요!"

    narrator "나는 가까스로 중심을 잡았다."
    narrator "하지만 나를 잡으려고 급하게 다가온 하린의 발이 사료 위에서 미끄러졌다."

    h "아……!"

    narrator "나는 하린의 팔을 붙잡았다."
    narrator "하린은 완전히 넘어지지는 않았지만, 오른발을 딛는 순간 얼굴을 살짝 찡그렸다."

    p "발목 다쳤어?"
    h "조금 접질린 것 같아요."
    p "걸을 수 있어?"

    narrator "하린은 조심스럽게 발을 내디뎠다."
    narrator "하지만 몸이 바로 한쪽으로 기울었다."

    p "그건 걸을 수 있는 상태가 아닌 것 같은데."
    h "많이 아프지는 않아요."

    narrator "교사가 우리 쪽으로 다가왔다."

    teach "서하린, 보건실에 가서 발목부터 확인해. 김남주가 같이 가."
    p "네."
    h "선생님, 저는 혼자 가도……."
    teach "발 제대로 못 딛고 있잖아. 부축받고 가."

    narrator "나는 하린의 팔을 내 어깨에 올렸다."

    p "천천히 가자."
    h "……죄송해요."
    p "나 잡아주다가 다친 건데 왜 네가 미안해."

    scene bg infirmary
    with fade
    show harin neutral at center
    with dissolve

    narrator "보건실에 도착했지만 안에는 아무도 없었다."
    narrator "책상 위에는 '잠시 교무실'이라고 적힌 메모가 놓여 있었다."

    p "선생님 오실 때까지 여기 앉아 있어."

    narrator "하린은 침대 가장자리에 앉았다."
    narrator "나는 냉동고에서 찜질팩을 꺼내 수건으로 감싼 뒤 하린에게 건넸다."

    p "발목 위에 올려."
    h "선배는 안 다쳤어요?"
    p "네가 잡아줘서 안 넘어졌어."
    h "그럼 다행이에요."
    p "너는 안 다행이잖아."

    narrator "하린은 찜질팩을 발목 위에 올린 채 시선을 내렸다."

    h "저는…… 괜찮다고 하면 보통 다들 괜찮은 줄 알아요."

    menu:
        "나는 안 괜찮아 보이면 다시 물어볼 거야.":
            p "나는 안 괜찮아 보이면 다시 물어볼 거야."

            narrator "하린의 손이 잠깐 멈췄다."

            h "제가 계속 괜찮다고 말해도요?"
            p "말하기 싫은 걸 억지로 묻지는 않을 거야. 그래도 그냥 지나치지는 않을게."
            h "그러면 제가 조금 곤란할 수도 있어요."
            p "아픈데 계속 괜찮다고 하는 것보다는 낫지 않을까."

            narrator "하린은 한동안 찜질팩을 내려다봤다."

            h "……지금은 조금 아파요."
            p "그렇게 말해주면 돼."

            $ harin_affection += 2

        "그럼 앞으로는 아프면 아프다고 말해.":
            p "그럼 앞으로는 아프면 아프다고 말해."
            h "말하면 괜히 걱정을 끼치는 것 같아서요."
            p "말을 안 하면 더 걱정할 수도 있어."

            narrator "하린은 찜질팩의 위치를 조금 옮겼다."

            h "바로 말하는 건 어려울 것 같아요."
            p "늦게라도 말해."
            h "……노력해볼게요."

        "괜찮다고 말했으면 괜찮은 줄 알 수밖에 없지.":
            p "괜찮다고 말했으면 괜찮은 줄 알 수밖에 없지."

            narrator "하린의 손끝에 힘이 들어갔다."

            h "그렇죠. 제가 그렇게 말했으니까요."

            narrator "하린은 찜질팩을 발목 위에 다시 올렸다."

            p "그래도 걷는 걸 보면 아픈 건 알 수 있어."
            h "많이 아픈 건 아니에요. 조금 놀란 것뿐이에요."
            p "알았어."

            narrator "하린은 더 말하지 않고 발목을 내려다봤다."

            $ harin_affection -= 1

    # 공통 후속 내용
    narrator "실습장 쪽에서 학생들의 목소리가 희미하게 들려왔다."

    p "다음에는 닭이 와도 바로 뒤로 물러나면 안 되겠다."
    h "사료를 다른 쪽에 뿌리면 돼요. 닭들이 사료를 따라가거든요."
    p "아까 네가 한 것처럼?"
    h "네. 한곳에 너무 많이 뿌리면 몰려드니까 조금씩 나눠서요."
    p "다음에는 들어가기 전에 네 설명부터 들어야겠네."
    h "다음에도 저랑 같은 조가 될지는 모르잖아요."
    p "같은 조면 좋을 것 같은데."

    narrator "하린이 고개를 들었다."

    p "닭 다루는 것도 잘 알고, 넘어질 때 잡아주기도 했잖아."
    h "결국 제가 다쳤는데요."
    p "그래도 나는 안 넘어졌어."

    narrator "하린은 잠시 내 얼굴을 바라보다가 작게 웃었다."

    h "다음에는 둘 다 안 다치게 할게요."
    p "그건 같이 조심해야지."

    narrator "하린은 찜질팩을 발목 위에 다시 고정했다."

    hide harin
    with dissolve
    jump barn_end


# ---------- 강연희 루트 ----------
label barn_yeonhee:
    show yeonhee neutral at center
    with dissolve

    narrator "연희가 점검표를 내려놓고 내 팔을 잡아당겼다."

    y "남주야, 이쪽!"

    narrator "나는 연희 쪽으로 끌려가며 가까스로 중심을 잡았다."
    narrator "하지만 연희의 신발이 사료 위에서 미끄러졌다."

    y "어……!"

    narrator "연희의 무릎이 바닥에 닿았다."

    p "연희야!"

    narrator "나는 연희의 팔을 잡아 몸을 일으켰다."
    narrator "연희는 무릎을 확인하더니 급하게 주변을 둘러봤다."

    y "잠깐, 방금 본 사람 많아?"
    p "지금 그게 중요해?"
    y "내 체면에는 중요하지."
    stu "연희야, 괜찮아?"
    y "괜찮아! 아무 일도 없었어!"
    stu "무릎에서 피 나는데?"
    y "그건 못 본 걸로 해줘."

    narrator "교사가 연희의 무릎을 확인했다."

    teach "피부가 조금 벗겨졌네. 보건실에 가서 소독해."

    narrator "교사는 나를 바라봤다."

    teach "김남주도 같이 가. 혼자 보내면 또 뛰어갈 것 같으니까."
    y "선생님, 저 그렇게까지 믿음이 없어요?"
    teach "지금도 웃으면서 일어나려고 하잖아."

    narrator "연희는 내 팔을 붙잡고 천천히 일어났다."

    y "그럼 오늘만 네 팔 좀 빌릴게."
    p "넘어질 때도 잡았잖아."
    y "오늘 네 팔 바쁘다."

    scene bg infirmary
    with fade
    show yeonhee neutral at center
    with dissolve

    narrator "보건실에는 아무도 없었다."
    narrator "연희는 침대 가장자리에 앉아 무릎을 내려다봤다."

    y "학년 통합 실습에서 전 학년 앞에 넘어지다니."
    p "전 학년이 너만 보고 있던 건 아니야."
    y "그렇게 말해도 이미 창피하거든."

    narrator "나는 소독약과 거즈를 꺼내 연희 옆에 놓았다."

    y "진짜 창피하다. 닭 피하다가 넘어지고, 너한테 잡히고."

    menu:
        "창피한 건 나중에 하고, 지금은 다친 것부터 보자.":
            p "창피한 건 나중에 하고, 지금은 다친 것부터 보자."

            narrator "연희는 웃으려다 입을 다물었다."

            y "너 지금 되게 진지하다."
            p "피 나는데 웃을 때는 아니잖아."

            narrator "나는 소독약을 거즈에 묻혔다."

            y "잠깐만. 분명히 따갑지?"
            p "조금."
            y "그 '조금' 믿어도 되는 거야?"
            p "안 하면 더 아파질 수도 있어."

            narrator "연희는 침대 시트를 움켜쥐었다."

            y "알겠어. 빨리 해."

            narrator "소독약이 닿자 연희의 어깨가 움찔했다."

            y "이건 조금이 아니잖아……."
            p "그래도 잘 참았어."

            narrator "연희는 나를 바라보다가 작게 웃었다."

            y "지금은 그 말이 장난처럼 안 들리네."

            $ yeonhee_affection += 2

        "그래도 크게 안 다쳐서 다행이야.":
            p "그래도 크게 안 다쳐서 다행이야."
            y "그건 맞아. 이 정도면 웃으면서 넘길 수 있지."

            narrator "연희는 무릎을 내려다보다가 얼굴을 찡그렸다."

            y "소독할 때까지 웃을 수 있을지는 모르겠지만."
            p "보건 선생님 오기 전에 상처부터 씻자."
            y "대신 너무 따가우면 네 팔 잡는다."
            p "이미 여러 번 잡았잖아."
            y "오늘은 네 팔이 안전 손잡이야."

        "그러게 왜 그렇게 자신만만했어?":
            p "그러게 왜 그렇게 자신만만했어?"

            narrator "연희의 웃음이 잠깐 멈췄다."

            y "그러게. 닭들이 내 말을 들을 줄 알았나 봐."

            narrator "연희는 소독약을 집어 들었다."

            p "다음에는 먼저 주변부터 봐."
            y "응. 오늘 제대로 배웠어."

            narrator "연희는 소독약의 뚜껑을 열다가 잠시 손을 멈췄다."

            y "이건 내가 할게. 이번에는 혼자 해도 되겠지?"
            p "필요하면 말해."
            y "알겠어."

            $ yeonhee_affection -= 1

