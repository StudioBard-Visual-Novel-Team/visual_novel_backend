# 이벤트 씬 – 청소 후, 해안가 도로
# 교실 → 해안가 도로 → 하린 / 연희 / 유나 루트 분기

label chapter2_intro:
    scene bg classroom
    with fade

    narrator "수업이 끝난 교실에는 빗자루가 바닥을 스치는 소리와 의자를 끄는 소리만 남아 있었다."
    narrator "조금 전까지만 해도 떠들썩하던 교실은 금세 조용해졌다."
    narrator "창가 쪽 책상에는 아직 지우지 못한 낙서 자국이 남아 있었고, 칠판 한쪽에는 마지막 수업 때 적어둔 글자가 희미하게 남아 있었다."
    narrator "나는 빗자루를 들고 교실 뒤쪽을 천천히 쓸었다."

    p "오늘따라 교실이 되게 조용하네."

    narrator "청소 당번 몇 명이 대충 대답하듯 고개를 끄덕였다."
    narrator "다들 빨리 끝내고 집에 가고 싶은 얼굴이었다."
    narrator "책상 밑에 떨어진 지우개 가루와 작은 종이 조각들을 쓸어 모으고, 의자를 하나씩 책상 안으로 밀어 넣었다."
    narrator "수업이 끝난 뒤라 그런지 학교 전체가 조금 느슨해진 느낌이었다."
    narrator "복도 쪽에서는 아직 남아 있는 학생들의 발소리가 들렸다."
    narrator "누군가는 동아리실로 향했고, 누군가는 실습복을 들고 실습실 쪽으로 걸어갔다."
    narrator "나는 쓰레받기에 먼지를 모아 쓰레기통에 털어 넣었다."

    p "이 정도면 거의 끝난 건가?"

    narrator "마지막으로 창문이 제대로 닫혔는지 확인하고, 교실 뒤에 세워둔 빗자루를 정리했다."
    narrator "청소가 끝나가자, 교실에 남아 있던 학생들도 하나둘씩 가방을 챙기기 시작했다."
    narrator "나도 가방을 챙겨 어깨에 멨다."
    narrator "이제는 이 교실의 자리 배치나 복도 방향 정도는 조금 익숙해졌다."
    narrator "처음에는 낯설기만 했던 학교였다."
    narrator "하지만 이상하게도, 하루가 끝날 때쯤이면 자꾸 떠오르는 얼굴이 있었다."
    narrator "나는 잠시 교실 안과 복도 쪽을 번갈아 바라봤다."
    narrator "오늘은 그냥 혼자 돌아가도 됐다."
    narrator "하지만 누군가와 같이 걸어도 나쁘지 않을 것 같았다."

    "[[청소가 끝났다. 누구와 귀가를 하고 싶은가?]"

    $ show_all_affection = True   # 이 선택지에서는 히로인 3명 호감도 모두 표시
    menu:
        "함께 귀가하는 상대를 고른다."
        "서하린과 함께 간다.":
            $ show_all_affection = False
            $ coastal_partner = "harin"
            jump coastal_harin
        "강연희와 함께 간다.":
            $ show_all_affection = False
            $ coastal_partner = "yeonhee"
            jump coastal_yeonhee
        "차유나 선배와 함께 간다.":
            $ show_all_affection = False
            $ coastal_partner = "yuna"
            jump coastal_yuna


# ---------- 서하린 루트 ----------
label coastal_harin:
    scene bg classroom
    with fade

    narrator "청소를 끝내고 교실을 나선 남주는 신발장 쪽으로 향했다."
    narrator "복도 끝에는 누군가 천천히 걸어오는 모습이 보였다."

    show harin neutral at center
    with dissolve

    p "하린아?"

    narrator "그 상대는 하린이었다."
    narrator "하린이는 작은 종이봉투를 품에 안고 있었다."
    narrator "안에는 실습실에서 쓰는 작은 이름표와 정리용 끈 같은 것들이 들어 있었다."

    h "선배. 안녕하세요."
    p "아직 안 갔어?"
    h "네. 실습실에 남은 물건을 조금 정리하고 있었어요."
    p "혼자서 한 거야?"

    narrator "하린이는 잠깐 시선을 피했다."

    h "그냥… 제가 하는 게 편해서 하고 있어요."
    p "무거운 거 아니야?"
    h "괜찮아요. 생각보다 안 무거워요."

    narrator "하린이는 그렇게 말했지만, 종이봉투를 안은 손에 힘이 들어간 것이 보였다."

    p "집 가는 길이야? 집 가는 길이면 들어줄게."
    h "집까지 같이요?"
    p "응. 나도 집 가는 길인데 집 가도 할 일이 없거든."
    h "…네. 괜찮으시면 같이 가요."

    scene bg coastal_road
    with fade
    stop music fadeout 1.5
    play sound "audio/ocean_waves_1.mp3" fadein 2.0 loop
    play music "audio/ocean_waves_1.mp3" fadein 2.0

    show harin neutral at center
    with dissolve

    narrator "남주와 하린은 나란히 교문을 나섰다."
    narrator "해안가 도로에 가까워질수록 바람이 조금 더 시원해졌다."
    narrator "하린은 익숙한 듯 바다 쪽으로 시선을 두고 걸었다."

    p "여기로 자주 다녀?"
    h "네. 거의 매일 여기로 다녀요."
    p "좋겠다. 하교길에 바다가 보이는 거잖아."
    h "...예쁘죠."
    p "응. 생각보다 훨씬 예쁘다."
    h "저도 처음엔 그렇게 생각했어요."
    p "처음엔?"
    h "네. 처음엔 매일 보는 게 신기했어요."
    h "학교 끝나고 집에 가는 길에 바다가 있다는 게… 조금 특별한 것 같아서요."
    p "지금은 아니야?"

    narrator "하린은 잠시 대답하지 않았다."
    narrator "바람이 불자, 하린의 머리카락이 살짝 흔들렸다."

    h "지금도 예뻐요."
    h "예쁜 건 그대로인데… 같이 보던 사람이 없어지면 조금 다르게 보일 때가 있어요."
    p "…"
    h "아, 이상한 말이었죠?"
    p "아니. 무슨 말인지 알 것 같아."
    h "그래요?"
    p "음. 같은 장소여도 누구랑 있느냐에 따라 다르게 느껴질 때 있잖아."

    narrator "하린은 조용히 고개를 끄덕였다."

    h "맞아요."
    h "그래서 저는… 예쁜 걸 보는 게 가끔 두려워요."
    p "왜?"
    h "나중에 혼자 다시 보게 되면, 그때 생각이 날 것 같아서요."

    menu:
        "그럼 오늘은 나랑 같이 본 걸로 기억하면 되겠다.":
            p "그럼 오늘은 나랑 같이 본 걸로 기억하면 되겠다."

            narrator "하린은 내 말을 듣고 잠깐 걸음을 멈췄다."
            narrator "바람에 머리카락이 살짝 흔들렸지만 하린은 한동안 아무 말도 하지 않았다."

            p "오늘 바다는 혼자 본 게 아니니까."

            narrator "하린은 천천히 나를 바라봤다."
            narrator "놀란 듯한 얼굴이었다."
            narrator "마치 그런 말을 들을 거라고는 전혀 생각하지 못한 사람 같았다."

            h "……그런 말은 쉽게 하지 마세요."
            p "쉽게 한 말 아니야."
            h "그렇게 말하면 더 곤란해요."
            p "왜?"

            narrator "하린은 바로 대답하지 않았다."
            narrator "대신 바다 쪽으로 시선을 돌렸다."

            h "쉽게 기억하게 되니까요."
            p "기억하면 안 돼?"
            h "안 되는 건 아닌데……"

            narrator "하린은 괜히 손끝을 만지작거렸다."

            h "나중에 혼자 다시 보게 될 때, 오늘 생각이 날 것 같아서요."
            p "그럼 그때도 오늘처럼 기억하면 되지 않을까?"
            h "선배는 그런 말을 너무 쉽게 해요."
            p "아까도 말했지만 쉽게 한 말은 아니야."

            narrator "하린은 대답하지 않았다."
            narrator "하지만 고개를 완전히 돌리지는 않았다."

            $ harin_affection += 2

        "그런 기억도 나쁘지만은 않을 거야.":
            p "그런 기억도 나쁘지만은 않을 거야."

            narrator "하린은 바다를 보던 시선을 천천히 내렸다."

            h "그럴까요?"
            p "응. 나중에 다시 봤을 때 외롭기만 한 기억은 아닐 수도 있잖아."
            h "좋았던 기억이면 더 아플 때도 있어요."
            p "그럴 수도 있겠다."

            narrator "나는 바로 대답하지 못했다."
            narrator "하린의 말이 틀렸다고 쉽게 말할 수 없었다."
            narrator "하린은 다시 바다를 봤다."

            h "저도 알아요. 예쁜 걸 계속 피하면서 살 수는 없다는 거."
            h "그런데 가끔은… 미리 겁이 나요."
            p "혼자 남게 될까 봐?"

            narrator "하린은 작게 고개를 끄덕였다."

            h "네."

            narrator "나는 한 손에 들고 있던 종이봉투를 고쳐 잡았다."
            narrator "봉투 안에서 이름표와 정리용 끈이 작게 흔들리는 소리가 났다."
            narrator "무슨 말을 해야 할지 잠깐 고민했다."

            p "그럼 오늘 기억이 너무 아픈 기억만 아니었으면 좋겠다."

            narrator "하린은 내 말을 듣고 살짝 눈을 깜빡였다."

            h "그건…… 아직 잘 모르겠어요."
            p "그래도 나쁜 기억은 아니었으면 좋겠어."

            narrator "하린은 작게 숨을 내쉬었다."

            h "네. 저도…… 그랬으면 좋겠어요."

        "그렇게 생각하면 아무것도 못 보지 않아?":
            p "그렇게 생각하면 아무것도 못 보지 않아?"

            narrator "하린은 순간 말을 멈췄다."
            narrator "조금 전까지 바다를 바라보던 눈이 천천히 아래로 내려갔다."

            h "…그렇죠."

            narrator "나는 그제야 내 말이 조금 세게 나갔다는 걸 느꼈다."

            p "아니, 그런 뜻으로 말한 건 아니고……"
            h "괜찮아요."

            narrator "대답이 빨랐다."
            narrator "그에 비해 목소리는 작아졌다."

            h "맞는 말이에요. 그렇게 생각하면 아무것도 못 보죠."
            p "하린아."
            h "그래서 저도 제가 답답할 때가 있어요."

            narrator "하린은 괜히 비어 있는 손을 움켜쥐었다."
            narrator "아까 내가 들어주겠다고 해서 종이봉투는 내 손에 있었지만, 하린은 오히려 손 둘 곳을 찾지 못하는 사람처럼 보였다."

            p "미안. 내가 말이 좀 급했나 봐."
            h "아니에요. 선배가 틀린 말 한 건 아니잖아요."

            narrator "그 말이 오히려 더 불편하게 들렸다."
            narrator "괜찮다고 말하는데, 이상하게 전혀 괜찮아 보이지 않았다."
            narrator "나는 더 이상 쉽게 말을 꺼내지 못했다."

            $ harin_affection -= 1

    # 공통 후속
    narrator "그 뒤로 우리는 한동안 말없이 걸었다."
    narrator "해안가 도로 옆으로 파도 소리가 계속 밀려왔다."
    narrator "바람은 시원했지만, 방금 나눈 대화 때문인지 공기는 조금 조심스러워진 것 같았다."
    narrator "나는 한 손에 종이봉투를 들고 다른 손으로 가방끈을 고쳐 잡았다."
    narrator "하린은 내 옆으로 천천히 걸었다."
    narrator "손에 들고 있던 짐이 없어졌는데도 어쩐지 걸음은 여전히 조심스러웠다."
    narrator "나는 하린이보다 반걸음 정도 느리게 속도를 맞췄다."
    narrator "억지로 말을 더 꺼내고 싶지는 않았다."
    narrator "지금은 묻는 것보다 그냥 옆에서 같이 걷는 쪽이 나을 것 같았다."
    narrator "잠시 후, 하린이 먼저 입을 열었다."

    h "선배."
    p "응?"

    narrator "하린은 바다 쪽을 바라본 채 말했다."

    h "오늘 바다는…… 조금 오래 남을 것 같아요."
    p "좋은 쪽으로?"

    narrator "하린은 바로 대답하지 않았다."

    h "그건 아직 잘 모르겠어요."
    p "그렇구나."
    h "그래도……"

    narrator "하린은 잠깐 말을 멈췄다."
    narrator "그리고 아주 작은 목소리로 덧붙였다."

    h "혼자 본 바다는 아니니까요."

    narrator "그 말은 바람 소리에 묻힐 만큼 작았다."
    narrator "하지만 나는 분명히 들었다."

    p "응. 혼자 본 건 아니지."

    narrator "하린은 고개를 살짝 숙였다."
    narrator "표정은 보이지 않았지만, 아까보다는 조금 편한 것 같았다."
    narrator "우리는 다시 해안가 도로를 따라 걸었다."
    narrator "나는 하린의 집 근처까지 종이봉투를 들고 걸었다."
    narrator "바다는 여전히 같은 자리에서 파도를 밀어내고 있었다."

    p "(바다가 예쁘다는 말에서 시작한 대화였는데.)"
    p "(어쩐지 하린의 마음 한쪽을 조금 본 것 같은 기분이 들었다.)"

    narrator "그날의 바다는, 나에게도 조금 오래 남을 것 같았다."

    hide harin
    with dissolve
    jump coastal_end


# ---------- 강연희 루트 ----------
label coastal_yeonhee:
    scene bg classroom
    with fade
    show yeonhee neutral at center
    with dissolve

    narrator "연희는 빗자루를 들고 교실 앞쪽을 쓸고 있었다."
    narrator "평소처럼 말이 많을 줄 알았는데, 의외로 손은 빠르게 움직였다."

    p "너 생각보다 청소 열심히 한다."
    y "생각보다라니? 나 원래 할 때는 해."
    p "그럼 평소에는 안 한다는 뜻이지?"
    y "그것은 듣는 사람이 알아서 해석하는 걸로."

    narrator "연희는 장난스레 웃으며 쓰레기를 한쪽으로 모았다."
    narrator "청소가 끝나자 연희는 빗자루를 벽에 기대 세우고 두 팔을 쭉 뻗었다."

    y "끝! 오늘의 노동은 이걸로 종료!"
    p "청소 하나 했는데 엄청난 일을 끝낸 것처럼 말하네."
    y "청소도 노동이야. 노동은 인정받아야 하고."
    p "그래. 수고했다."
    y "오."
    p "왜?"
    y "방금 좋았어. 한 번 더 해봐."
    p "싫어."
    y "너무하네. 사람 칭찬은 아끼면 안 되는 거야."

    narrator "연희는 웃으며 가방을 챙겼다."
    narrator "복도로 나오자 이미 학생들은 거의 빠져나간 뒤였다."

    y "남주. 너 집 해안가 도로 근처지?"
    p "그쪽이지요."
    y "오케이 그럼 같이 가."
    p "거절할 틈은?"
    y "없어. 이미 결정된 거야."
    p "너 진짜 빠르다."
    y "좋은 건 빨리 해야지."

    scene bg coastal_road
    with fade
    stop music fadeout 1.5
    play sound "audio/ocean_waves_1.mp3" fadein 2.0 loop
    play music "audio/ocean_waves_1.mp3" fadein 2.0

    show yeonhee neutral at center
    with dissolve

    narrator "두 사람은 나란히 교문을 나섰다."
