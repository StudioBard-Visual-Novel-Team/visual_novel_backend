# 이벤트 씬 3 – 청소 후, 해안가 도로
# 교실 → 해안가 도로 → 하린 / 연희 / 유나 루트 분기
# 서하린 루트는 이벤트 1의 선택(umbrella_partner)에 따라 분기됨

label event_coastal_intro:
    scene bg classroom
    with fade

    narrator "마지막 수업이 끝나자 학생들이 자리에서 일어났다."

    p "오늘 청소 당번 누구였지?"
    stu "칠판에 적혀 있어. 너도 당번이야."
    p "아, 맞다. 그럼 내가 교실 뒤쪽부터 쓸게."
    stu "나는 칠판 지울게. 빨리 끝내고 가자."

    narrator "학생들이 각자 청소 도구를 집어 들었다."
    narrator "나는 교실 뒤편에서 빗자루를 가져와 책상 사이를 쓸기 시작했다."

    p "이 의자 좀 들어줄래? 밑에 종이가 있어."
    stu "응. 잠깐만."

    narrator "학생 1이 의자를 들어 올리자, 나는 밑에 있던 종이 조각을 쓸어냈다."

    p "처음에는 교실도 잘못 찾아갔는데, 요즘은 실습실 가는 길도 안 헷갈리더라."
    stu "처음에 다른 반 교실 문 열려고 했던 거 너였지?"
    p "봤어? 아무도 못 본 줄 알았는데."
    stu "그때 복도에 있던 애들은 거의 다 봤을걸."
    p "그런 걸로 기억되고 싶지는 않았어."

    narrator "청소하던 학생들이 작게 웃었다."
    narrator "얼마 지나지 않아 바닥에 흩어져 있던 먼지와 종이 조각이 한곳에 모였다."

    p "이쪽은 다 끝난 것 같은데, 창문도 확인할게."

    narrator "나는 열려 있던 창문을 닫고 잠금장치를 확인했다."

    p "창문까지 다 닫았어. 이제 가도 되겠다."
    stu "좋아. 오늘 청소 끝."
    stu "수고했어. 내일 보자."
    p "내일 봐."

    narrator "학생 2가 먼저 복도로 나갔다."
    narrator "학생 1은 가방을 멘 채 교실 문 앞에 멈췄다."

    stu "남주야, 너도 바로 집에 가?"
    p "응. 아마도. 복도에서 누구랑 마주치면 같이 갈 수도 있고."
    stu "이제 학교에서 아는 사람도 꽤 생겼나 보네."
    p "처음보다는 많이 생겼지."

    narrator "학생 1은 손을 흔들고 복도로 나갔다."
    narrator "나는 가방을 어깨에 메고 열린 교실 문 쪽을 바라봤다."

    "[[청소가 끝났다. 누구와 귀가를 하고 싶은가?]"

    menu:
        "함께 귀가하는 상대를 고른다."
        "서하린과 함께 간다.":
            $ coastal_partner = "harin"
            jump coastal_harin
        "강연희와 함께 간다.":
            $ coastal_partner = "yeonhee"
            jump coastal_yeonhee
        "차유나 선배와 함께 간다.":
            $ coastal_partner = "yuna"
            jump coastal_yuna


# ---------- 서하린 루트 ----------
label coastal_harin:
    scene bg classroom
    with fade

    narrator "교실을 나오자 복도 끝에서 하린이 걸어오고 있었다."

    show harin neutral at center
    with dissolve

    narrator "하린은 작은 종이봉투를 품에 안고 있었다."
    narrator "봉투 안에는 하린이 개인적으로 사용하던 화분 이름표와 정리용 끈이 들어 있었다."

    p "하린아, 아직 안 갔어?"
    h "교실에 두고 간 물건이 있어서 가지러 왔어요."
    p "그 봉투에 든 건 뭐야?"
    h "제가 쓰던 이름표랑 정리용 끈이에요. 집에서 정리하려고요."
    p "무거워 보이는데 내가 들게."
    h "별로 안 무거워요."
    p "그래도 같은 방향이면 근처까지 들어줄게. 집이 가까워?"
    h "해안가 도로에서 조금만 더 가면 돼요."
    p "그럼 근처까지 같이 가자."

    narrator "하린은 종이봉투를 내려다보다가 내게 건넸다."

    h "……그럼 부탁드릴게요."

    scene bg coastal_road
    with fade
    stop music fadeout 1.5
    play sound "audio/ocean_waves_1.mp3" fadein 2.0 loop
    play music "audio/ocean_waves_1.mp3" fadein 2.0

    show harin neutral at center
    with dissolve

    narrator "우리는 함께 교문을 나섰다."
    narrator "해안가 도로에 가까워지자 바람이 조금 강해졌다."

    # [CG – 서하린 / 강한 바람에 머리 흩날림·치마와 종이봉투 붙잡기]
    narrator "바다 쪽에서 더 강한 바람이 불었다."
    narrator "하린의 긴 머리가 얼굴 앞으로 흩날렸고, 치맛자락이 바람에 크게 흔들렸다."
    narrator "하린은 한 손으로 종이봉투를 품에 안고, 다른 손으로 치마를 조심스럽게 붙잡았다."

    p "괜찮아?"
    h "네. 갑자기 불어서 조금 놀랐어요."

    narrator "나는 하린이 바람을 덜 맞도록 바다 쪽에 섰다."

    h "선배, 일부러 그쪽으로 가신 거예요?"
    p "바람이 그쪽에서 오니까."

    narrator "하린은 머리카락을 귀 뒤로 넘기며 나를 바라봤다."
    narrator "잠시 뒤 바람이 약해졌다. 하린은 흐트러진 머리카락과 치맛자락을 정리했고, 나는 종이봉투를 다시 받아 들었다."
    narrator "우리는 나란히 해안가 도로를 걷기 시작했다."

    if umbrella_partner == "harin":
        # [ 이벤트 1에서 서하린 루트 선택 시 ]
        p "전에 비 오던 날에도 이 길로 갔었지."
        h "네. 그날도 선배랑 같이 걸었어요."
        p "오늘은 비가 안 와서 다행이네."
        h "그래도 바람은 그날보다 많이 불어요."
    else:
        # [ 이벤트 1에서 강연희 루트 또는 차유나 루트 선택 시 ]
        p "이 길이 꽤 익숙해 보이네."
        h "거의 매일 다니는 길이에요."
        p "매일 바다를 보면서 집에 가는 거네."
        h "네. 처음에는 조금 신기했어요."

        narrator "하린은 바다를 바라보며 걸음을 늦췄다."

        h "지금도 예뻐요. 그런데 같이 보던 사람이 없어지면 같은 장소도 다르게 보여요."
        p "같이 보던 사람이 생각나서?"
        h "네. 그래서 가끔은 예쁜 걸 보는 게 무서워요. 나중에 혼자 다시 보게 될까 봐요."

    # [ 공통 남주 선택지 ]
    menu:
        "그럼 오늘은 나랑 같이 본 바다로 기억해.":
            p "그럼 오늘은 나랑 같이 본 바다로 기억해."

            narrator "하린은 천천히 내 쪽을 바라봤다."

            h "그런 말은 오래 남아요."
            p "오래 남아도 괜찮아. 오늘 혼자 본 건 아니잖아."

            narrator "하린은 앞머리를 손끝으로 정리하며 바다 쪽으로 고개를 돌렸다."

            h "선배는 나중에 이 길을 걸으면 오늘 생각이 날 것 같아요?"
            p "아마 날 것 같은데."

            narrator "하린의 걸음이 조금 느려졌다."

            h "그럼 저만 기억하는 건 아니겠네요."
            p "응."
            h "……그건 조금 안심돼요."

            $ harin_affection += 2

        "그런 기억이 꼭 아프기만 하지는 않을 거야.":
            p "그런 기억이 꼭 아프기만 하지는 않을 거야."
            h "좋았던 기억이라서 더 아플 때도 있어요."
            p "그럴 수도 있겠다."

            narrator "하린은 내 대답에 조금 놀란 듯 고개를 들었다."

            p "네가 느끼는 걸 내가 아니라고 할 수는 없잖아. 그래도 오늘이 나쁜 기억은 아니었으면 좋겠어."

            narrator "하린은 잠시 바다를 바라봤다."

            h "지금은 나쁘지 않아요."
            p "그럼 됐네."
            h "나중에도 그랬으면 좋겠어요."

        "그렇게 겁내면 아무것도 못 보지 않아?":
            p "그렇게 겁내면 아무것도 못 보지 않아?"

            narrator "하린은 바다에서 시선을 내렸다."

            h "알아요. 그래서 저도 제가 답답할 때가 있어요."
            p "계속 피할 수는 없잖아."
            h "저도 피하고 싶어서 그러는 건 아니에요."

            narrator "하린은 비어 있는 손을 천천히 움켜쥐었다."

            h "그냥 나중에 혼자 남는 게 먼저 생각나는 거예요."

            narrator "나는 더 말을 붙이지 않고 종이봉투를 고쳐 들었다."
            narrator "하린은 조금 떨어진 채 내 옆을 걸었다."

            $ harin_affection -= 1

    # 공통 후속 내용
    narrator "한동안 파도 소리만 이어졌다."
    narrator "나는 하린의 걸음에 맞춰 천천히 걸었다."

    h "선배."
    p "응?"
    h "아까부터 제 속도에 맞춰 걷고 있죠?"
    p "네가 원래 천천히 걷잖아."
    h "선배는 더 빨리 걸을 수 있는데요."
    p "같이 가는데 한 사람이 먼저 가면 이상하잖아."

    narrator "하린은 잠시 나를 바라보다가 다시 바다 쪽으로 고개를 돌렸다."

    h "오늘 바다는 조금 오래 남을 것 같아요."
    p "왜?"
    h "혼자 본 게 아니니까요."
    p "나도 기억해둘게."

    narrator "하린은 작은 목소리로 대답했다."

    h "네."

    narrator "바닷바람이 불었지만 하린의 걸음은 조금 전보다 가벼워져 있었다."

    hide harin
    with dissolve
    jump coastal_end


# ---------- 강연희 루트 ----------
label coastal_yeonhee:
    scene bg classroom
    with fade
    show yeonhee neutral at center
    with dissolve

    narrator "연희는 빗자루를 정리한 뒤 내 옆으로 다가왔다."

    y "남주, 청소 끝났지?"
    p "방금 끝났어."
    y "그럼 같이 가자. 너도 해안가 도로 쪽이잖아."
    p "내 대답은 필요 없는 거야?"
    y "거절할 것 같았으면 물어보지도 않았지."

    narrator "우리는 나란히 교문을 나섰다."

    scene bg coastal_road
    with fade
    stop music fadeout 1.5
    play sound "audio/ocean_waves_1.mp3" fadein 2.0 loop
    play music "audio/ocean_waves_1.mp3" fadein 2.0

    show yeonhee neutral at center
    with dissolve

    narrator "해안가 도로에 들어서자 연희가 앞서 걸으며 두 팔을 벌렸다."
    narrator "조금 더 걷자 해안가 아래쪽으로 내려가는 작은 계단이 보였다."
    narrator "연희는 난간 너머를 보더니 갑자기 걸음을 멈췄다."

    y "잠깐만. 물가까지 내려갈 수 있네."
    p "집에 안 가?"
    y "진짜 잠깐만."

    narrator "연희는 신발을 벗고 계단을 내려갔다. 얕은 물가에 발을 담근 연희는 차가운 물에 몸을 살짝 움츠렸다."

    y "차가워! 근데 좋다."

    # [CG – 강연희 / 얕은 물가에서 물장구]
    narrator "연희는 발끝으로 물을 가볍게 튀겼다. 작은 물방울이 햇빛을 받아 반짝였다."

    p "교복 젖는다."
    y "조금만 할게."

    narrator "그 말이 끝나자마자 연희는 한 번 더 물을 찼고, 이번에는 내 쪽으로 물방울이 튀었다."

    p "방금 일부러지?"
    y "아니. 바다가 한 거야."

    narrator "물장구를 치던 연희는 잠시 뒤 조용히 바다를 바라봤다."

    y "이런 건 혼자 하면 그냥 이상한데, 같이 있으면 추억 같아지네."

    narrator "연희는 물가에서 나와 신발을 들고 돌계단으로 돌아왔다."

    y "오늘 바람 진짜 시원하다."
    p "그러네."
    y "그게 끝이야? 이런 날에는 조금 더 감탄해줘야지."
    p "청소하면서 감탄할 힘까지 다 썼어."

    narrator "연희가 웃음을 터뜨렸다."

    y "너 은근히 한마디씩 웃기게 한다니까."

    narrator "얼마 후 연희는 앞서가던 걸음을 늦추고 내 옆으로 돌아왔다."

    y "근데 나랑 있으면 시끄럽지?"

    menu:
        "시끄럽긴 한데 불편하진 않아. 너랑 있으면 심심하지도 않고.":
            p "시끄럽긴 한데 불편하진 않아. 너랑 있으면 심심하지도 않고."

            narrator "연희는 걸음을 멈출 듯하다가 다시 걸었다."

            y "그 말 은근히 기분 좋다."
            p "은근히만?"
            y "너무 좋아하면 티 나잖아."

            narrator "연희는 바다 쪽으로 고개를 돌렸지만 입가에는 웃음이 남아 있었다."

            y "그럼 앞으로도 적당히 시끄럽게 해줄게."
            p "굳이 노력하지 않아도 될 것 같은데."
            y "그건 맞아."

            $ yeonhee_affection += 2

        "조용하진 않지.":
            p "조용하진 않지."

            narrator "연희는 발끝으로 작은 돌을 툭 찼다."

            y "단호하네."
            p "물어봐서 대답한 거야. 같이 걷기 싫다는 뜻은 아니고."
            y "그럼 됐어. 조용하진 않아도 같이 걷기는 괜찮다는 거잖아."

            narrator "연희는 다시 내 옆에 걸음을 맞췄다."

            y "그 정도면 나쁘지 않네."

        "솔직히 조금 피곤하긴 해.":
            p "솔직히 조금 피곤하긴 해."

            narrator "연희의 걸음이 잠깐 느려졌다."

            y "아, 그렇구나."

            narrator "연희는 웃었지만 평소보다 목소리가 낮아졌다."

            y "오늘은 말 좀 줄일게. 청소도 했으니까 너도 조용히 가고 싶을 수 있지."
            p "아예 말하지 말라는 뜻은 아니야."
            y "알아. 그래도 조금은 줄이는 게 낫겠네."

            narrator "연희는 앞을 바라본 채 손을 뒤로 모았다."

            $ yeonhee_affection -= 1

    # 공통 후속 내용
    narrator "잠시 동안 파도 소리만 들렸다."
    narrator "연희는 바닷바람에 흐트러진 앞머리를 손으로 눌렀다."

    y "사실 나도 내가 말 많은 건 알아."
    p "일부러 많이 하는 거야?"
    y "완전히 일부러는 아닌데, 조용하면 상대가 무슨 생각을 하는지 모르겠거든."

    narrator "연희는 난간 너머의 바다를 바라봤다."

    y "재미없는 사람처럼 보이는 것도 싫고. 내가 가만히 있으면 그냥 없어도 되는 사람처럼 느껴질 때도 있어."
    p "말이 없어도 옆에 있는 건 똑같잖아."
    y "너는 그렇게 생각해?"
    p "지금도 조용히 같이 걷고 있잖아."

    narrator "연희는 잠시 말없이 걸었다."
