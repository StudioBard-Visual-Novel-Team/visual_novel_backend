# 이벤트 씬 1 – 비 오는 날, 우산
# 교실 → 교문 앞 → 하린 / 연희 / 유나 루트 분기

label event_umbrella:
    scene bg school_playground_sunset__rain_1
    with fade
    stop music fadeout 1.0
    play sound "audio/rain_sound_1.mp3" fadein 1.0 loop
    play music "audio/rain_sound_1.mp3" fadein 1.5

    narrator "창문을 두드리는 빗소리가 점점 커졌다."

    p "뭐야, 아까까지만 해도 맑았는데."
    stu "너 일기예보 안 봤어?"
    p "아침에는 비 얘기 없었던 것 같은데."

    narrator "창가에 앉은 학생들이 하나둘씩 밖을 바라봤다."
    narrator "운동장 위로 굵은 빗줄기가 쏟아지고 있었다."

    t "우산 없는 사람은 비가 조금 약해질 때까지 교실이나 현관에서 기다려. 뛰어가다가 넘어지지 말고."
    p "선생님, 이거 금방 약해질까요?"
    t "그건 선생님도 모르지."

    narrator "교실 여기저기에서 웃음이 터졌다."
    narrator "종례가 끝나자 학생들이 가방을 챙기기 시작했다."

    stu "[player_name][josa(player_name, '아야')], 너 우산 있어?"
    p "가방에 하나 넣어둔 것 같은데. 잠깐만."

    narrator "나는 가방 안쪽 주머니를 뒤졌다."
    narrator "손끝에 접이식 우산이 걸렸다."

    p "있다. 안 빼놓길 잘했네."
    stu "나는 옆 반 친구한테 연락해볼게. 너는 먼저 가."
    p "그래. 내일 보자."

    scene bg school_playground_sunset__rain_1
    with fade

    narrator "교문 앞 처마에는 비를 피하는 학생들이 모여 있었다."
    narrator "나는 처마 끝에서 우산을 꺼내 바깥의 빗줄기를 바라봤다."

    p "그냥 뛰어가기는 무리겠네."

    narrator "접이식 우산을 펼쳐 크기를 확인했다."

    p "이 정도면 둘이 써도 괜찮겠는데."

    narrator "나는 펼친 우산을 들고 교문 밖으로 나갈 준비를 했다."
    narrator "빗줄기는 여전히 거셌다."
    narrator "누구와 함께 갈지 잠시 생각했다."

    p "(같이 갈 사람이 있을까.)"

    menu:
        "함께 우산을 쓸 상대를 고른다."
        "서하린에게 다가간다.":
            $ umbrella_partner = "harin"
            jump umbrella_harin
        "강연희에게 다가간다.":
            $ umbrella_partner = "yeonhee"
            jump umbrella_yeonhee
        "차유나 선배에게 다가간다.":
            $ umbrella_partner = "yuna"
            jump umbrella_yuna


# ---------- 서하린 루트 ----------
label umbrella_harin:
    scene cg rain harin
    with dissolve
    pause

    narrator "처마 기둥 옆에 하린이 서 있었다."
    narrator "하린은 바깥으로 손을 내밀어 빗줄기의 세기를 확인하더니, 금방 손을 거두었다."

    p "하린아, 우산 없어?"
    h "네. 아침에는 비가 안 올 것 같아서……."
    p "나랑 같이 가자. 혼자 쓰기엔 충분히 커."

    narrator "하린은 내 손에 들린 우산을 바라봤다."

    h "선배 집도 이쪽이에요?"
    p "응. 해안가 도로 쪽으로 가."
    h "그럼…… 조금만 같이 가도 될까요?"
    p "집은 어디 쪽이야?"
    h "해안가 도로에서 조금 더 가면 돼요."
    p "그럼 근처까지 같이 가도 돼."

    narrator "하린은 잠시 망설이다가 내 옆으로 다가왔다."
    narrator "우산을 펼치자 빗소리가 머리 위에서 크게 울렸다."

    # [CG – 서하린 / 우산 안 밀착]
    narrator "교문을 나서자 바람이 섞인 비가 옆으로 들이쳤다."
    narrator "하린의 어깨 쪽으로 빗방울이 튀었다."

    p "조금 더 안쪽으로 와. 그쪽 젖어."
    h "괜찮아요."

    narrator "말은 그렇게 했지만, 하린은 가방을 품에 끌어안고 몸을 작게 움츠렸다."
    narrator "나는 우산을 더 하린 쪽으로 기울였다. 그러자 내 어깨가 우산 밖으로 조금 나갔다."

    h "선배, 어깨 젖어요."
    p "나는 괜찮아."

    narrator "하린은 내 어깨 쪽을 보다가 아주 조금 망설인 뒤 내 쪽으로 다가왔다."
    narrator "팔과 팔 사이의 거리가 거의 없어졌다."

    h "이렇게 하면…… 둘 다 덜 젖을 것 같아요."
    p "응. 그게 낫겠다."

    narrator "하린은 고개를 살짝 숙였다. 우산 위로 빗소리가 가까워졌다."
    narrator "나는 하린 쪽으로 우산을 조금 기울였다."

    h "선배."
    p "응?"
    h "우산이 너무 제 쪽으로 기울어졌어요. 선배 어깨가 젖어요."

    menu:
        "네가 비 맞는 것보다는 나아.":
            p "네가 비 맞는 것보다는 나아."

            narrator "하린은 젖어가는 내 어깨를 바라봤다."

            h "저 때문에 선배가 젖는 거잖아요."
            p "같이 가자고 한 건 나야. 네가 신경 쓸 일은 아니지."

            narrator "하린은 아무 말 없이 우산 손잡이 쪽으로 손을 뻗었다가 멈췄다."

            h "제가 조금 들게요."
            p "괜찮아. 대신 조금만 안쪽으로 걸어."

            narrator "하린은 이번에는 망설이지 않고 반걸음 가까이 다가왔다."

            h "……고마워요."

            $ harin_affection += 2

        "이 정도는 괜찮아.":
            p "이 정도는 괜찮아."
            h "교복 색이 달라질 정도로 젖었는데요."
            p "집에 가서 말리면 돼."

            narrator "하린은 우산 가운데를 바라보다가 조심스럽게 말했다."

            h "그럼 우산을 조금만 가운데로 옮겨주세요. 저도 조금 젖어도 괜찮아요."
            p "둘 다 젖는 게 더 낫다는 거야?"
            h "한 사람만 젖는 것보다는 나아요."

            narrator "나는 우산을 가운데로 옮겼다."
            narrator "하린은 우산 가장자리를 확인하고 작게 고개를 끄덕였다."

            h "이제 괜찮아요."

        "그럼 네가 조금 더 안쪽으로 와.":
            p "그럼 네가 조금 더 안쪽으로 와."

            narrator "하린의 걸음이 잠깐 멈췄다."

            p "그래야 둘 다 안 젖잖아."
            h "네……."

            narrator "하린은 조심스럽게 가까이 다가왔다."
            narrator "어깨가 닿을 만큼 가까워지자 하린의 몸에 힘이 들어갔다."
            narrator "하린은 가방끈을 잡은 채 앞만 바라봤다."

            p "너무 가까웠어?"
            h "조금 놀랐어요."

            narrator "하린은 우산 가장자리 쪽으로 다시 조금 물러났다."

            h "그래도 이 정도면 괜찮아요."

            $ harin_affection -= 1

    # 공통 후속 내용
    narrator "우리는 빗소리를 들으며 천천히 걸었다."
    narrator "도로 옆 배수로로 빗물이 빠르게 흘러갔다."
    narrator "지나가던 차가 물웅덩이를 밟자 하린이 안쪽으로 몸을 피했다."

    p "여기는 비 오면 원래 이렇게 물이 많이 고여?"
    h "네. 바다 쪽에서 바람까지 불면 더 심해져요."
    p "매일 다니는 길이라 잘 아네."
    h "거의 매일 혼자 걸었으니까요."

    narrator "하린은 마지막 말을 작게 덧붙였다."

    p "오늘은 혼자가 아니네."

    narrator "하린은 빗물이 흐르는 도로를 바라봤다."

    h "그러네요."

    narrator "잠시 후 하린이 내 쪽으로 고개를 돌렸다."

    h "선배는 누군가랑 같이 가던 길을 나중에 혼자 걸으면 생각나요?"
    p "같이 걸었던 사람이?"
    h "네."
    p "아마 생각날 것 같은데."

    narrator "하린은 우산 가장자리를 바라보며 작게 말했다."

    h "저도 그래요. 그래서 같이 걷는 게 좋으면서도 조금 무서워요."
    p "오늘 일도 생각날 것 같아?"
    h "비가 많이 오는 날에는요."
    p "그럼 나쁜 기억은 아니었으면 좋겠네."

    narrator "하린은 바로 대답하지 않았다."

    h "……네. 저도요."

    narrator "우리는 다시 같은 속도로 빗길을 걸었다."

    hide harin
    with dissolve
    jump umbrella_end


# ---------- 강연희 루트 ----------
label umbrella_yeonhee:
    narrator "나는 우산을 쓰고 교문을 지나가려 했다."
    narrator "그때 현관 쪽에서 누군가가 뛰어나왔다."

    scene cg rain yeonhee
    with dissolve
    pause

    y "아, 진짜 갑자기 오네!"

    narrator "연희는 가방을 머리 위로 들고 운동장 쪽으로 뛰어가려다, 빗줄기가 더 세지는 걸 보고 멈춰 섰다."

    # [CG – 강연희 / 비 맞은 히로인]
    narrator "짧은 단발 끝과 어깨가 이미 젖어 있었다. 그래도 연희는 민망한 표정보다 먼저 장난스러운 웃음을 지었다."

    p "연희야, 우산 없어?"

    narrator "연희가 나를 발견하고 눈을 크게 떴다."

    y "[player_name][josa(player_name, '아야')]. 너 우산 있었어?"
    p "응. 같이 쓸래?"

    narrator "연희는 젖은 앞머리를 손으로 넘기며 내 우산 쪽으로 다가왔다."

    y "그럼 오늘은 네 우산 신세 좀 질게."
    p "뛰어가려고 했어?"
    y "처음에는 가능할 줄 알았지. 근데 비가 나보다 빠르더라."
    p "그건 당연한 거 아니야?"
    y "해보기 전엔 모르는 거야."

    menu:
        "응. 비 맞게 두긴 좀 그렇잖아.":
            p "응. 비 맞게 두긴 좀 그렇잖아."

            narrator "연희는 바로 우산 안으로 들어오지 않고 잠시 나를 바라봤다."

            y "생각보다 다정하게 말하네."
            p "그냥 감기 걸릴 것 같아서 그래."
            y "그 말을 굳이 덧붙이는 게 [player_name]답다."

            narrator "연희는 웃으며 내 옆으로 들어왔다."

            y "그래도 고마워. 비 맞고 뛰어갈 각오까지 하고 있었거든."
            p "그 각오는 안 해도 돼."
            y "오늘은 네 덕분에 포기."

            $ yeonhee_affection += 2

        "비 맞고 갈 생각은 아니었잖아.":
            p "비 맞고 갈 생각은 아니었잖아."
            y "사실 뛰어갈지 기다릴지 고민 중이었어."
            p "뛰어갔으면 교복 다 젖었을걸."
            y "그러니까 지금 네가 굉장히 적절한 타이밍에 나타난 거지."

            narrator "연희는 우산 아래로 들어오며 손가락으로 빗물을 털었다."

            y "오늘의 운은 아직 나쁘지 않네."
            p "우산을 안 챙긴 건 네 선택이고."
            y "그건 내일의 내가 반성할 예정이야."

        "계속 여기 있으면 시끄러울 것 같아서.":
            p "계속 여기 있으면 시끄러울 것 같아서."

            narrator "연희의 웃음이 잠깐 멈췄다."

            y "지금까지 몇 마디 하지도 않았는데 벌써 시끄러워?"
            p "평소 기준까지 포함한 거야."

            narrator "연희는 입술을 살짝 내밀었다."

            y "그렇게 말하고 우산은 같이 쓰자고 하는 게 더 이상해."
            p "비 맞게 두는 것보다는 낫잖아."
            y "그건 고맙지만, 오늘은 말수 조금 줄여줄게."

            narrator "연희는 우산 안으로 들어왔지만 평소보다 한 걸음 떨어져 걸었다."

            $ yeonhee_affection -= 1

    # 공통 후속 내용
    narrator "연희는 우산 아래로 들어오자 젖은 앞머리를 손으로 정리했다."

    y "진짜 많이 온다. 이 정도면 하늘이 나한테 억하심정 있는 거야."
    p "아침에 우산을 안 챙긴 네 잘못은?"
    y "아침엔 맑았으니까 무죄."
    p "판결이 너무 본인 위주인데."
    y "내 재판이니까."

    narrator "연희는 웃으며 우산 밖으로 손을 내밀었다."
    narrator "차가운 빗물이 닿자 바로 손을 거두었다."

    y "그래도 혼자 기다리는 것보다는 훨씬 낫다."
    p "기다리는 거 싫어해?"
    y "기다리는 건 괜찮은데, 다들 먼저 가고 혼자 남는 건 별로야."

    narrator "연희는 대수롭지 않게 말하며 젖은 손을 치마 옆에 털었다."

    p "그래서 계속 사람을 붙잡고 이야기하는 거야?"
    y "그것도 있고, 조용하면 재미없잖아."
    p "지금은 안 조용하네."
    y "내가 열심히 하고 있으니까."

    narrator "바람에 우산이 흔들리자 연희가 손잡이를 함께 잡았다."

    y "내가 이쪽 잡을게. 바람 불면 뒤집힐 수도 있어."
    p "우산이 없던 사람이 갑자기 적극적이네."
    y "이제 절반은 내 거라며."

    narrator "우리가 함께 손잡이를 잡자 우산이 흔들리지 않았다."

    y "다음에 비 오면 또 같이 가자."
    p "다음에는 우산을 챙겨."
    y "그러면 각자 써야 하잖아."

    narrator "연희는 장난스럽게 웃으며 내 옆에 걸음을 맞췄다."

    hide yeonhee
    with dissolve
    jump umbrella_end


# ---------- 차유나 루트 ----------
label umbrella_yuna:
    narrator "나는 우산을 펴고 교문을 나섰다."
    narrator "교문 밖 인도 쪽에서 선배가 걸음을 멈추고 있었다."

    scene cg rain yuna
    with dissolve
    pause

    # [CG – 차유나 / 비 맞은 히로인]
    narrator "긴 머리 끝이 비에 젖어 어깨 쪽에 붙어 있었고, 손에는 접힌 서류 봉투가 들려 있었다."

    p "선배."

    narrator "선배는 뒤돌아보다가 내 우산을 확인했다."

    sen "아직 안 갔네."
    p "선배는 우산 없으세요?"
    sen "학생회실에 있던 여분 우산은 1학년에게 빌려줬어."
    p "그럼 같이 쓰고 가요."
    sen "괜찮아. 잠깐 기다리면 돼."

    narrator "빗줄기는 기다리면 더 세질 것처럼 보였다."
    narrator "나는 말없이 선배 쪽으로 우산을 기울였다."

    p "서류 젖어요."

    narrator "선배는 손에 든 봉투를 내려다봤다. 잠시 짧게 숨을 내쉬었지만, 아직 우산 안으로 들어오지는 않았다."

    menu:
        "기다리는 것보다 같이 가는 게 낫잖아요.":
            p "기다리는 것보다 같이 가는 게 낫잖아요."
            sen "우리 집 방향을 알아?"
            p "해안가 도로 쪽으로 가시는 건 봤어요. 중간까지라도 같이 가요."

            narrator "나는 우산을 펼쳐 선배가 들어올 공간을 만들었다."

            p "혼자 기다리는 것보다는 빠르잖아요."

            narrator "선배는 내 우산과 빗길을 번갈아 바라봤다."

            sen "너는 생각보다 잘 밀어붙이네."
            p "필요할 때만요."
            sen "……알았어. 같이 가."

            $ yuna_affection += 2

        "비가 꽤 많이 오는데요.":
            p "비가 꽤 많이 오는데요."
            sen "보고 있어."
            p "이 정도면 한참 기다려야 할 것 같아요. 괜찮으시면 우산 같이 쓰시죠."

            narrator "선배는 잠시 나를 바라봤다."

            sen "갑작스럽네."
            p "우산을 같이 쓰는 데 준비가 필요한 건 아니잖아요."
            sen "그건 그렇지."

            narrator "선배는 가방을 안쪽으로 옮겼다."

            sen "중간까지만 빌릴게."

        "그럼 저는 먼저 갈게요.":
            p "그럼 저는 먼저 갈게요."
            sen "그래."

            narrator "나는 우산을 펼치고 처마 밖으로 한 걸음 나갔다."
            narrator "하지만 우산을 빌려준 선배가 혼자 남아 있는 모습이 계속 눈에 들어왔다."
            narrator "나는 몇 걸음 가지 못하고 다시 돌아섰다."

            p "선배."

            narrator "선배는 예상했다는 듯 내 쪽을 바라봤다."

            p "생각해보니 그냥 가기는 좀 그래서요. 같이 가실래요?"
            sen "처음부터 그렇게 말하면 됐잖아."
            p "저도 나가고 나서 생각났어요."

            narrator "선배는 짧게 숨을 내쉬었다."

            sen "이번에는 다시 안 갈 거지?"
            p "네."
            sen "그럼 갈게."

            $ yuna_affection -= 1

    # 공통 후속 내용
    narrator "선배는 우산 안으로 들어오면서 손잡이를 가운데로 옮겼다."

    p "제가 들게요."
    sen "지금처럼 들면 네 어깨가 젖어."

    narrator "선배는 손잡이의 각도를 바로잡았다."

    p "이런 것도 정확하게 맞추시네요."
    sen "둘 다 안 젖는 쪽이 낫잖아."

    narrator "우리는 교문을 나와 해안가 도로 쪽으로 걸었다."
    narrator "비가 세게 내렸지만 우산 아래에서는 서로의 발소리까지 들렸다."

    p "우산 빌려준 학생은 잘 갔을까요?"
    sen "기숙사까지 간다고 했으니까 문제없을 거야."
    p "선배는 본인이 남는 건 괜찮고요?"
    sen "그 학생이 감기에 걸리는 것보다는 나아."
    p "선배도 똑같이 감기에 걸릴 수 있잖아요."

    narrator "선배는 잠시 대답하지 않았다."

    sen "그래서 지금 네 우산을 쓰고 있잖아."
    p "그러네요."

    narrator "선배의 걸음이 내 속도에 맞춰 조금 느려졌다."
    narrator "갈림길에 가까워졌을 때 선배가 입을 열었다."

    sen "고마워."
    p "네."

    narrator "선배는 더 말하지 않았지만, 갈림길에 도착할 때까지 내 걸음보다 먼저 나아가지 않았다."

    hide yuna
    with dissolve
    jump umbrella_end


# ---------- 우산 이벤트 종료 ----------
label umbrella_end:
    stop music fadeout 2.0
    stop sound fadeout 2.0

    scene black
    with fade
    pause 1.0

    jump chapter2
