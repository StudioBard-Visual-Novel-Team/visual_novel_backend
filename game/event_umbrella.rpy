# 이벤트 씬 1 – 비 오는 날, 우산
# 교문 앞 → 하린 / 연희 / 유나 루트 분기

label event_umbrella:
    scene bg school_playground_sunset__rain_1
    with fade
    stop music fadeout 1.0
    play sound "audio/rain_sound_1.mp3" fadein 1.0 loop
    play music "audio/rain_sound_1.mp3" fadein 1.5

    narrator "수업이 끝나자마자 하늘이 무너지듯 비가 쏟아졌다."
    narrator "아침까지만 해도 맑았던 하늘은 어느새 먹구름으로 뒤덮여 있었다."

    p "뭐야, 아침엔 맑았는데 갑자기 쏟아지네."

    narrator "종례가 끝나자 학생들은 서둘러 가방을 챙겼다."
    narrator "누군가는 접이식 우산을 꺼냈고, 누군가는 친구에게 같이 쓰고 가자며 매달렸다."
    narrator "남주는 가방 안쪽 주머니를 뒤져 접이식 우산을 꺼냈다."

    p "가방에 넣어두길 잘했네."

    narrator "교문 앞은 금세 사람들로 붐볐다."
    narrator "우산을 펴는 학생들, 비가 약해지길 기다리는 학생들, 그냥 뛰어가려다 포기한 학생들이 처마 밑에 뒤섞여 있었다."
    narrator "비는 쉽게 그칠 기미가 보이지 않았다."
    narrator "남주는 우산을 펴려다, 문득 처마 밑에 서 있는 사람들을 바라봤다."
    narrator "그때, 우산 없이 서 있는 누군가가 눈에 들어왔다."
    narrator "잠깐 모르는 척 지나갈까 생각했지만, 이미 눈이 마주친 뒤였다."
    narrator "괜히 그냥 지나치기에는 조금 신경 쓰였다."

    $ show_all_affection = True   # 이 선택지에서는 히로인 3명 호감도 모두 표시
    menu:
        "함께 우산을 쓸 상대를 고른다."
        "서하린에게 다가간다.":
            $ show_all_affection = False
            $ umbrella_partner = "harin"
            jump umbrella_harin
        "강연희에게 다가간다.":
            $ show_all_affection = False
            $ umbrella_partner = "yeonhee"
            jump umbrella_yeonhee
        "차유나 선배에게 다가간다.":
            $ show_all_affection = False
            $ umbrella_partner = "yuna"
            jump umbrella_yuna


# ---------- 서하린 루트 ----------
label umbrella_harin:
    show harin neutral at center
    with dissolve

    narrator "처마 기둥 옆에 긴 머리를 늘어뜨린 채 조용히 비를 바라보는 하린이 있었다."
    narrator "비를 보는 건지, 다른 무언가를 보는 건지 알 수 없는 눈빛이었다."

    p "하린아, 우산 없어?"

    narrator "하린이 고개를 돌렸다. 잠깐 남주를 보더니, 다시 시선을 비 쪽으로 돌렸다."

    h "없어요."
    p "같이 쓰자. 나도 이쪽 방향이라."

    narrator "하린은 한 박자 늦게 대답했다."

    h "…괜찮아요?"
    p "괜찮아. 혼자서 쓰기엔 우산이 좀 커서."

    narrator "하린은 조금 망설였다."
    narrator "마치 가도 되는지, 정말 폐가 되지 않는지 확인하는 사람 같았다."

    h "그럼… 조금만 같이 가도 될까요?"
    p "당연하지."

    narrator "우산 하나에 두 사람이 나란히 섰다. 빗소리가 머리 위로 두드렸다."
    narrator "하린은 말이 없었다. 하지만 거부감은 없어 보였다."
    narrator "조금 좁았지만, 남주는 애써 하린 쪽으로 우산을 기울였다."

    h "선배. 우산… 너무 제 쪽으로 기울이고 계세요."
    h "어깨 다 젖어요."

    menu:
        "네가 비 맞는 것보단 나아.":
            p "네가 비 맞는 것보단 나아."

            narrator "하린은 잠깐 말을 멈췄다."
            narrator "빗소리만 우산 위를 두드렸다."

            h "……저 때문에 선배가 젖는 건데요."
            p "방금 말했잖아. 네가 젖는 것 보단 내가 젖는게 괜찮지."

            narrator "하린은 남주의 어깨를 다시 바라봤다."
            narrator "무언가 말하려는 듯 입술이 살짝 움직였지만, 결국 아무 말도 하지 않았다."
            narrator "대신 하린은 아주 조금, 정말 아주 조금 남주 쪽으로 가까이 섰다."

            p "조금 더 들어와도 돼."
            h "이 정도면…… 괜찮아요."
            p "그래."

            narrator "하린은 고개를 살짝 숙였다."

            h "고마워요."

            narrator "목소리는 작았지만, 빗소리 사이에서도 분명히 들렸다."

            $ harin_affection += 1

        "이 정도는 괜찮아.":
            p "이 정도는 괜찮아."

            narrator "하린은 바로 대답하지 않았다."
            narrator "대신 내 어깨 쪽을 힐끗 바라봤다."

            h "전혀 괜찮아 보이지 않는데요."
            p "조금 젖는 정도야 뭐."
            h "감기 걸릴 수도 있어요."
            p "그 정도까진 아닐걸."

            narrator "하린은 잠깐 고민하듯 눈을 내렸다."
            narrator "그러다 조심스럽게 우산 손잡이 쪽을 바라봤다."

            h "그럼…… 우산 조금만 가운데로 들어도 괜찮아요."
            p "네가 비 맞을 수도 있는데."
            h "저도 조금은 괜찮아요."

            narrator "나는 우산을 아주 조금 가운데로 옮겼다."
            narrator "우리 사이의 거리는 그대로였지만, 우산 아래의 공간이 조금 더 공평해졌다."

            h "이게 더 나아요."
            p "그래?"
            h "네."

            narrator "하린은 다시 앞을 바라봤다."
            narrator "평소처럼 조용했지만, 조금 전보다 덜 불편해 보였다."

        "그럼 네가 조금 더 안쪽으로 와.":
            p "그럼 네가 조금 더 안쪽으로 와."

            narrator "하린은 순간 멈칫했다."

            h "아……"
            p "그래야 둘 다 덜 젖잖아."
            h "네…… 그렇긴 한데."

            narrator "하린은 아주 조심스럽게 한 걸음 가까이 다가왔다."
            narrator "하지만 몸이 굳어 있는 게 보였다."
            narrator "우산 안쪽으로 들어왔는데도, 하린은 괜히 가방끈만 만지작거렸다."

            p "불편해?"
            h "아니에요."

            narrator "대답은 정말 빨랐다."
            narrator "하지만 괜찮아 보이지는 않았다."

            p "미안. 갑자기 말해서 놀랐어?"
            h "조금은요."

            narrator "하린은 다시 시선을 비 쪽으로 돌렸다."

            h "그래도…… 괜찮아요."

            narrator "괜찮다는 말과 달리, 목소리는 조금 작아져 있었다."

            $ harin_affection -= 1

    # 공통 후속
    narrator "우리는 다시 천천히 걸었다."
    narrator "우산 위로 떨어지는 빗소리가 일정하게 이어졌다."
    narrator "하린은 여전히 말이 없었다."
    narrator "하지만 처음처럼 완전히 멀리 서 있지는 않았다."
    narrator "나는 하린의 걸음에 맞춰 속도를 조금 늦췄다."

    h "선배."
    p "응?"

    narrator "하린은 잠깐 망설이다가 작게 말했다."

    h "저한테 그런 말을 해주는 사람들은 보통 먼저 가버려요."
    p "응? 못 들었어. 뭐라고 말했어?"
    h "아무 말도 아니에요."

    narrator "하린은 고개를 살짝 숙였다."

    h "고마워요."

    narrator "아주 작은 목소리였다."
    narrator "나는 그 말을 들었지만, 일부러 모르는 척 앞을 바라봤다."

    p "(하린이는 조용한 아이라고만 생각했는데.)"
    p "(방금 말은 이상하게 오래 남았다.)"

    narrator "비는 여전히 내리고 있었다."
    narrator "하지만 우산 아래의 거리는, 처음보다 아주 조금 가까워져 있었다."

    hide harin
    with dissolve
    jump umbrella_end


# ---------- 강연희 루트 ----------
label umbrella_yeonhee:
    show yeonhee neutral at center
    with dissolve

    narrator "처마 밑에서 연희가 손을 내밀어 빗방울을 잡으려 하고 있었다."
    narrator "우산 없이도 전혀 걱정이 없어 보이는 얼굴이었다."

    y "어? 남주! 우산 있어?"
    p "응. 너 없어?"
    y "없지!"
    p "그걸 왜 그렇게 당당하게 말해."

    narrator "연희는 장난스럽게 웃었다."
    narrator "하지만 웃고 나서 아주 잠깐, 남주의 표정을 확인했다."

    y "어때? 나 지금 좀 불쌍해 보이지?"
    p "아니. 그냥 비 맞기 직전의 사람 같아."
    y "그게 불쌍한 거잖아!"

    narrator "남주가 우산을 살짝 들어 보였다."

    p "같이 쓸래?"
    y "오, 먼저 말해주는 거야?"

    menu:
        "응. 비 맞게 두긴 좀 그렇잖아.":
            p "응. 비 맞게 두긴 좀 그렇잖아."

            narrator "연희는 잠깐 눈을 크게 떴다."
            narrator "그러더니 곧 장난스럽게 웃었다."

            y "오."
            p "왜?"
            y "방금 좀 괜찮았다?"
            p "그게?"
            y "응. 그냥 같이 쓰자는 말보다 더 친절했던 거 같아."
            p "비 맞는 사람 보면 보통 그러지 않아?"
            y "아닌 사람도 많거든."

            narrator "연희는 그렇게 말하고 내 우산을 힐끗 바라봤다."
            narrator "말투는 가벼웠지만, 표정은 생각보다 기분 좋아 보였다."

            y "그럼 오늘은 당신의 친절에 감사히 기대겠습니다."
            p "말이 너무 거창하신데요?"
            y "고마운 티는 확실히 내야지."

            $ yeonhee_affection += 1

        "비 맞고 갈 생각은 아니었잖아.":
            p "비 맞고 갈 생각은 아니었잖아."
            y "그건 그렇지."

            narrator "연희는 기다렸다는 듯 우산 쪽으로 한 걸음 다가왔다."

            y "솔직히 뛰어갈지 말지 고민 중이었어."
            p "그랬으면 다 젖었을걸."
            y "딩동댕 정답!"

            narrator "연희는 웃으며 우산 밖으로 손을 살짝 내밀었다."
            narrator "손끝에 빗방울이 톡톡 떨어졌다."

            y "와, 진짜 많이 온다."
            p "그러니까 들어오는 게 낫지."
            y "응. 오늘 판단 괜찮았어, 남주~"
            p "왜 네가 날 평가해."
            y "그냥 하고 싶어서."

        "네가 계속 여기 있으면 시끄러울 것 같아서.":
            p "네가 계속 여기 있으면 시끄러울 것 같아서."
            y "야."

            narrator "연희가 바로 눈을 가늘게 떴다."

            y "나 아직 그렇게 많이 말 안 했거든??"
            p "이미 충분히 한 것 같은데."
            y "너 은근히 말 세게 한다?"
            p "그런가?"

            narrator "연희는 입술이 살짝 삐죽였다."
            narrator "하지만 바깥에 쏟아지는 비를 보더니, 다시 우산 쪽을 바라봤다."

            y "그래도 들어가도 돼?"
            p "응. 비 맞는 것보단 낫잖아."
            y "흥. 오늘은 특별히 조용한 버전으로 들어가 줄게."
            p "그게 가능해?"
            y "방금 취소. 조용히 안 할래."
            p "빠르네."

            narrator "연희는 조금 삐친 듯하다."

            $ yeonhee_affection -= 1

    # 공통 후속
    narrator "연희는 우산 속으로 쏙 들어왔다."
    narrator "우산 하나에 두 사람이 들어가자 생각보다 공간이 좁았다."
    narrator "빗소리가 머리 위로 두드렸고, 처마 밑의 소란은 조금씩 멀어졌다."

    y "그럼 실례하겠습니다~"
    p "이미 들어왔잖아."
    y "말은 하고 들어와야 예의지."
    p "순서를 반대로 하셨어요."
    y "아이, 중요한 건 마음이야."

    narrator "뭔가 대화의 주도권이 이상한 방향으로 넘어갔다."
    narrator "연희는 우산 밖으로 손을 살짝 내밀었다."
    narrator "손끝에 빗방울이 닿자, 금방 다시 손을 안으로 들였다."

    y "진짜 많이 온다. 우산 없었으면 큰일 날 뻔했네."
    p "그러니까 챙기고 다녀."
    y "아침엔 맑았잖아. 이건 하늘이 날 배신한 거야."
    p "하늘 탓이야?"
    y "응. 난 잘못 없어."
    p "되게 당당하네."
    y "당당해야 덜 민망하거든."

    narrator "그 말에 나는 연희를 잠깐 바라봤다."
    narrator "연희는 웃고 있었지만, 젖은 앞머리를 만지작거리는 손끝은 조금 어색해 보였다."

    y "아무튼 고마워. 덕분에 안 젖고 가네."
    p "그 정도야 뭐."
    y "그 정도가 좋은 거야."
    p "뭐가?"
    y "별거 아닌 것처럼 챙겨주는 거."

    narrator "연희는 그렇게 말하고 다시 앞을 봤다."
    narrator "평소처럼 장난스러운 목소리였지만, 이번에는 아주 조금 진심이 섞여 있는 것 같았다."

    p "너는 그런 말 잘한다."
    y "진짜? 나 그런 거 잘해 보여?"
    p "응. 사람 기분 좋게 하는 거 잘해 보여."
    y "오……"

    narrator "연희는 잠깐 말을 멈췄다가, 다시 평소처럼 웃었다."

    y "그럼 앞으로도 나랑 자주 다녀야겠네. 기분 좋아지게 해줄 테니까!"
    p "그건 네가 정하는 거야?"
    y "응. 방금 정했어. 앞으로 자주 다녀!"

    narrator "빗소리 사이로 연희와의 수다는 이어졌다."
    narrator "나는 어느새 그 대화에 자연스럽게 끌려 들어가고 있었다."

    p "(확실히 시끄러운 애다.)"
    p "(근데 이상하게, 기분 나쁘지 않은 소음이다.)"

    hide yeonhee
    with dissolve
    jump umbrella_end


# ---------- 차유나 루트 ----------
label umbrella_yuna:
    show yuna neutral at center
    with dissolve

    narrator "교문 바깥에, 교복 차림의 선배가 비를 바라보며 서 있었다."
    narrator "그 자리에 그냥 서 있을 것 같은 사람이었다."

    p "선배님, 우산 없으세요?"

    narrator "유나가 천천히 남주 쪽으로 시선을 옮겼다."

    u "우산은 빌려줬어."
    p "누구한테요?"
    u "우산 없는 1학년."
    p "이젠 선배가 우산 없으시잖아요."
    u "나는 기다리면 돼."

    menu:
        "기다리는 것보다 같이 가는 게 낫잖아요.":
            p "기다리는 것보다 같이 가는 게 낫잖아요."

            narrator "선배는 잠시 나를 바라봤다."
